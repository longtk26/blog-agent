# blog-agent configuration. Copy to `.env` (make up does this on first run).
# Secrets live ONLY here (read by the api service); the browser never sees them.

# ---- Docker Compose ---------------------------------------------------------
POSTGRES_USER=blog_agent
POSTGRES_PASSWORD=blog_agent
POSTGRES_DB=blog_agent
# Host ports, bound to 127.0.0.1 only
DB_PORT=5433
API_PORT=8100
UI_PORT=3100

# Used when the API runs on the host (`make dev`). Inside compose this is overridden to point at `db`.
DB_URL=postgresql://blog_agent:blog_agent@127.0.0.1:5433/blog_agent

# ---- API runtime ------------------------------------------------------------
ENV=local
# true enables debug-only endpoints (/health/llm, /health/graph)
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# Shared key between the UI proxy and the API (recommended). Generate: openssl rand -hex 24
AGENT_API_KEY=

# ---- LLM models: "<provider>:<model>" (LangChain init_chat_model) ------------
# Every role falls back to LLM_DEFAULT_MODEL. Examples: google_genai:gemini-3.8-flash, anthropic:claude-sonnet-5-5
LLM_DEFAULT_MODEL=
# LLM_PLANNER_MODEL=   # research plan, outline
# LLM_WRITER_MODEL=    # drafting, revisions
# LLM_FAST_MODEL=      # per-source assessment, classification (e.g. google_genai:gemini-3.1-flash-lite)
# LLM_JUDGE_MODEL=     # evaluation
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_RETRIES=2

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---- Research (Epic 2) ----------------------------------------------------------
# auto = Tavily when TAVILY_API_KEY is set, otherwise keyless DuckDuckGo (fine for trying it out).
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
# Comma-separated domains never used as sources
RESEARCH_DOMAIN_DENYLIST=pinterest.com,quora.com
# Server-side maximums a task's budgets may not exceed
# RESEARCH_MAX_QUERIES=20
# RESEARCH_MAX_SOURCES=40
# RESEARCH_MAX_ROUNDS=4
# RESEARCH_QUALITY_THRESHOLD=0.5
# WORKFLOW_MAX_CONCURRENCY=2

# ---- LangSmith tracing --------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=blog-agent-local
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Hide prompt/response payloads from traces (metadata and timings are still sent)
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
