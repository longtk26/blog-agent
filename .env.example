# blog-agent configuration. Copy to `.env` (make up does this on first run).
# Secrets live ONLY here (read by the api service); the browser never sees them.

# ---- Docker Compose ---------------------------------------------------------
POSTGRES_USER=blog_agent
POSTGRES_PASSWORD=blog_agent
POSTGRES_DB=blog_agent
# Host ports, bound to 127.0.0.1 only
DB_PORT=5433
API_PORT=8100
UI_PORT=3100

# Used when the API runs on the host (`make dev`). Inside compose this is overridden to point at `db`.
DB_URL=postgresql://blog_agent:blog_agent@127.0.0.1:5433/blog_agent

# ---- API runtime ------------------------------------------------------------
ENV=local
# true enables debug-only endpoints (/health/llm, /health/graph)
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# Shared key between the UI proxy and the API (recommended). Generate: openssl rand -hex 24
AGENT_API_KEY=

# ---- LLM models: "<provider>:<model>" (LangChain init_chat_model) ------------
# Every role falls back to LLM_DEFAULT_MODEL. Examples: google_genai:gemini-3.8-flash, anthropic:claude-sonnet-5-5
LLM_DEFAULT_MODEL=
# LLM_PLANNER_MODEL=   # research plan, outline
# LLM_WRITER_MODEL=    # drafting, revisions
# LLM_FAST_MODEL=      # per-source assessment, classification (e.g. google_genai:gemini-3.1-flash-lite)
# LLM_JUDGE_MODEL=     # evaluation
# LLM_VISION_MODEL=    # diagram visual review; must accept images (Gemini models do)
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_RETRIES=2

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---- Local agent CLIs instead of API keys (Epic 11) -----------------------------
# Any LLM_*_MODEL may be "agy:<model>" (Antigravity CLI; `agy models` lists ids, e.g. agy:gemini-3.8-flash-medium,
# agy:claude-sonnet-5-5-medium) or "claude_code:<model>" (Claude Code CLI; sonnet | opus | haiku | full id).
# "<provider>:default" uses the CLI's own default model. They run on your CLI login (no per-token cost in the
# task budget); temperature/max_tokens are not applied. Embeddings (Epic 6) and thumbnails still use GOOGLE_API_KEY.
# Inside Docker, start with `make up CLI=1` to mount the host CLIs and their logins (see docker-compose.cli.yml).
# AGY_BIN=agy
# CLAUDE_CODE_BIN=claude
# AGY_EXTRA_ARGS=                 # e.g. --effort low
# CLAUDE_CODE_EXTRA_ARGS=         # e.g. --effort low
# CLI_LLM_TIMEOUT_SECONDS=600     # per call; agent CLIs are slower than API calls
# CLI_LLM_MAX_CONCURRENCY=2       # parallel CLI processes per CLI
# CLAUDE_CODE_OAUTH_TOKEN=        # optional: from `claude setup-token`, instead of mounting ~/.claude

# ---- Research (Epic 2) ----------------------------------------------------------
# auto = Tavily when TAVILY_API_KEY is set, otherwise keyless DuckDuckGo (fine for trying it out).
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
# Comma-separated domains never used as sources
RESEARCH_DOMAIN_DENYLIST=pinterest.com,quora.com
# Server-side maximums a task's budgets may not exceed
# RESEARCH_MAX_QUERIES=20
# RESEARCH_MAX_SOURCES=40
# RESEARCH_MAX_ROUNDS=4
# RESEARCH_QUALITY_THRESHOLD=0.5
# WORKFLOW_MAX_CONCURRENCY=2

# ---- Review (Epic 4) ------------------------------------------------------------
# Safety net on AI revision rounds per task, and the budget for follow-up research asked for in review
# MAX_REVIEW_ROUNDS=10
# REVIEW_RESEARCH_MAX_QUERIES=4
# REVIEW_RESEARCH_MAX_SOURCES=6

# ---- Publishing (Epic 5) --------------------------------------------------------
SANITY_PROJECT_ID=
SANITY_DATASET=blogs
SANITY_API_VERSION=2025-01-20
SANITY_API_WRITE_TOKEN=
SANITY_SITE_BASE_URL=https://leon-pham.vercel.app
SANITY_STUDIO_BASE_URL=https://abcs.sanity.studio
# SANITY_TEST_DATASET=blogs-test   # Opt-in live test dataset
SANITY_GENERATE_THUMBNAIL=true
THUMBNAIL_MODEL=gemini-3.1-flash-image
BLOGS_EXPORT_ENABLED=false
BLOGS_DIR=../blogs

# ---- DEV Community Publishing (Epic 8) ---------------------------------------
DEV_TO_API_KEY=
# DEV_TO_BASE_URL=https://dev.to/api

# ---- Style & Knowledge Base (Epic 6) -------------------------------------------
EMBEDDING_MODEL=google_genai:gemini-embedding-001
EMBEDDING_DIM=768
# STYLE_SAMPLE_MAX_TOKENS=1500
# COPY_DETECTION_NGRAM=8
# COPY_DETECTION_WARN_THRESHOLD=0.15
# COPY_DETECTION_BLOCK_THRESHOLD=0.30
# COPY_DETECTION_RUN_WORDS=40


# ---- Editable Diagrams (Epic 7) -----------------------------------------------
DIAGRAM_RENDERER_URL=http://renderer:8080
# DIAGRAM_RENDER_TIMEOUT=45
# DIAGRAM_MAX_CONCURRENT_RENDERS=2
# DIAGRAM_VISUAL_REVIEW=true        # vision review of each rendered diagram (counts toward the task budget)
# DIAGRAM_REVIEW_MAX_ROUNDS=2

# ---- LangSmith tracing --------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=blog-agent-local
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Hide prompt/response payloads from traces (metadata and timings are still sent)
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
